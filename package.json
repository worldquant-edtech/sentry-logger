{
  "name": "@wqlearning/sentry-logger",
  "version": "1.0.6",
  "description": "A TypeScript logger wrapper for Sentry with CommonJS and ESM support",
  "keywords": [
    "sentry",
    "logger",
    "typescript",
    "error-tracking",
    "monitoring"
  ],
  "license": "ISC",
  "author": "WorldQuant Learning",
  "repository": {
    "type": "git",
    "url": "https://github.com/wqlearning/sentry-logger.git"
  },
  "homepage": "https://github.com/wqlearning/sentry-logger#readme",
  "bugs": {
    "url": "https://github.com/wqlearning/sentry-logger/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/cjs/index.cjs"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && npm run rename:cjs",
    "rename:cjs": "./scripts/rename-cjs.sh",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "dist/cjs",
    "dist/index.d.ts"
  ],
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@sentry/node": "^10.15.0"
  }
}
